# InfluxDB Cloud endpoint for your region, e.g. us-east-1-1.
TS_HOST=https://us-east-1-1.aws.cloud2.influxdata.com

# Two more variables are required and have no default:
TS_TOKEN=     # InfluxDB Cloud → Load Data → API Tokens → Generate API Token
              # (write access to the bucket below is enough)
TS_DATABASE=  # the bucket name that token can write to
